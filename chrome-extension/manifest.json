{
  "manifest_version": 3,
  "name": "BEQ Tab EQ",
  "short_name": "BEQ Tab",
  "version": "1.0.0",
  "description": "A 10-band EQ and level for each browser tab, from Born To EQ The World.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BEQ Tab EQ",
    "default_icon": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" }
  },
  "icons": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" }
}
